<ui:FluentWindow x:Class="Zapret.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tb="http://www.hardcodet.net/taskbar"
                 xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                 Title="Zapret2"
                 Width="820" Height="720"
                 MinWidth="700" MinHeight="560"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen">

  <ui:FluentWindow.Resources>
    <SolidColorBrush x:Key="RingOff" Color="#3B424B" po:Freeze="True" />

    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Nav" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Margin" Value="6,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
              <Grid>
                <Border x:Name="Pill" Width="3" Height="18" CornerRadius="1.5"
                        HorizontalAlignment="Left" Margin="2,0,0,0"
                        Background="{DynamicResource AccentTextFillColorPrimaryBrush}" Opacity="0" />
                <ContentPresenter VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter TargetName="Pill" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavIcon" TargetType="ui:SymbolIcon">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Zapret2" ShowMaximize="True">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/icon.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <tb:TaskbarIcon x:Name="Tray"
                    Grid.Row="0"
                    ToolTipText="Zapret2"
                    IconSource="pack://application:,,,/Assets/icon.ico"
                    TrayMouseDoubleClick="TrayOpen_Click">
      <tb:TaskbarIcon.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Открыть" Click="TrayOpen_Click" />
          <MenuItem x:Name="TrayToggle" Header="Подключить" Click="Toggle_Click" />
          <Separator />
          <MenuItem Header="Выход" Click="Exit_Click" />
        </ContextMenu>
      </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavColumn" Width="220" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Margin="0,4,0,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:Button x:Name="NavToggle" Grid.Row="0" Appearance="Transparent" Width="36" Padding="0,8" Margin="6,4,0,8"
                   HorizontalAlignment="Left" HorizontalContentAlignment="Center" Icon="{ui:SymbolIcon Navigation24}"
                   Click="NavToggle_Click" ToolTip="Свернуть меню" />

        <StackPanel Grid.Row="1">
          <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="dashboard"
                       IsChecked="True" Checked="Nav_Checked" ToolTip="Главная">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="Home24" />
              <TextBlock Grid.Column="1" x:Name="NavHomeLabel" Text="Главная" VerticalAlignment="Center" />
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavLists" Style="{StaticResource NavItem}" Tag="lists" Checked="Nav_Checked" ToolTip="Списки">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="TextBulletListSquare24" />
              <TextBlock Grid.Column="1" x:Name="NavListsLabel" Text="Списки" VerticalAlignment="Center" />
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavEditor" Style="{StaticResource NavItem}" Tag="editor" Checked="Nav_Checked" ToolTip="Стратегии">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="Wrench24" />
              <TextBlock Grid.Column="1" x:Name="NavEditorLabel" Text="Стратегии" VerticalAlignment="Center" />
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavJournal" Style="{StaticResource NavItem}" Tag="journal" Checked="Nav_Checked" ToolTip="Журнал">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="DocumentBulletList24" />
              <TextBlock Grid.Column="1" x:Name="NavJournalLabel" Text="Журнал" VerticalAlignment="Center" />
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavDiag" Style="{StaticResource NavItem}" Tag="diagnostics" Checked="Nav_Checked" ToolTip="Диагностика">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="Stethoscope24" />
              <TextBlock Grid.Column="1" x:Name="NavDiagLabel" Text="Диагностика" VerticalAlignment="Center" />
            </Grid>
          </RadioButton>
        </StackPanel>

        <RadioButton x:Name="NavSettings" Grid.Row="2" Style="{StaticResource NavItem}" Tag="settings"
                     Checked="Nav_Checked" ToolTip="Настройки">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="Settings24" />
            <TextBlock Grid.Column="1" x:Name="NavSettingsLabel" Text="Настройки" VerticalAlignment="Center" />
          </Grid>
        </RadioButton>
      </Grid>

      <Border Grid.Column="1" Width="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

      <Grid Grid.Column="2" Margin="24,8,24,20">

        <StackPanel x:Name="DashboardPanel" VerticalAlignment="Center">
          <Border Width="220" Height="220" Background="Transparent"
                  Cursor="Hand" MouseLeftButtonUp="Connect_Click" HorizontalAlignment="Center">
            <Grid>
              <Ellipse x:Name="ConnectPulse" Width="220" Height="220"
                       Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}" StrokeThickness="2" Opacity="0" />
              <Ellipse Width="220" Height="220" Stroke="#1AFFFFFF" StrokeThickness="1" />
              <Ellipse x:Name="ConnectRing" Width="184" Height="184"
                       Stroke="{StaticResource RingOff}" StrokeThickness="6" Fill="#14000000" />
              <Ellipse x:Name="Spinner" Width="184" Height="184" Visibility="Collapsed"
                       Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}" StrokeThickness="4"
                       StrokeDashArray="16 90" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <RotateTransform x:Name="SpinnerRotate" />
                </Ellipse.RenderTransform>
              </Ellipse>
              <ui:SymbolIcon x:Name="ConnectIcon" Symbol="Power24" FontSize="68"
                             VerticalAlignment="Center" HorizontalAlignment="Center"
                             Foreground="{StaticResource RingOff}" />
            </Grid>
          </Border>

          <TextBlock x:Name="StatusTitle" Text="Не защищено" Margin="0,26,0,0"
                     FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock x:Name="StatusSub" Text="Нажмите кнопку, чтобы включить обход"
                     Margin="0,4,0,0" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

          <StackPanel x:Name="UptimePanel" Orientation="Horizontal" HorizontalAlignment="Center"
                      Margin="0,10,0,0" Visibility="Collapsed">
            <ui:SymbolIcon Symbol="Timer24" FontSize="15" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="UptimeText" Margin="7,0,0,0" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" FontFamily="Consolas"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          </StackPanel>

          <Border Margin="0,26,0,0" Padding="14,10" CornerRadius="10" MaxWidth="420"
                  Background="{DynamicResource ControlFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Grid.Column="0" Symbol="ShieldTask24" FontSize="24"
                             VerticalAlignment="Center" Margin="2,0,14,0"
                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="СТРАТЕГИЯ" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="StrategyCombo" DisplayMemberPath="Label"
                          SelectionChanged="StrategyCombo_SelectionChanged"
                          BorderThickness="0" Background="Transparent" Padding="0,2" Margin="-2,2,0,0" />
              </StackPanel>
            </Grid>
          </Border>

          <ui:Button x:Name="AutoPickButton" Margin="0,14,0,0" MinWidth="220"
                     HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                     Content="Авто-подбор" Icon="{ui:SymbolIcon Sparkle24}" Click="AutoPick_Click" />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <ui:SymbolIcon Symbol="TextBulletListSquare24" FontSize="14" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ListCountsText" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="списки…" />
          </StackPanel>
        </StackPanel>

        <Grid x:Name="ListsPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,4,0,12">
            <TextBlock Text="Списки" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <CheckBox x:Name="SelectAllCheck" Content="Все" VerticalAlignment="Center" Margin="0,0,14,0"
                        Checked="SelectAll_Changed" Unchecked="SelectAll_Changed" />
              <ui:Button Content="Экспорт выбр." FontSize="12" Icon="{ui:SymbolIcon ArrowExport24}"
                         Click="ExportSelected_Click" Margin="0,0,8,0" />
              <ui:Button Content="Удалить выбр." FontSize="12" Icon="{ui:SymbolIcon Delete24}"
                         Click="DeleteSelected_Click" Margin="0,0,16,0" />
              <ui:Button Content="Добавить файл" Icon="{ui:SymbolIcon ArrowImport24}"
                         Click="AddListFile_Click" Margin="0,0,8,0" />
              <ui:Button Content="Создать" Icon="{ui:SymbolIcon DocumentAdd24}"
                         Click="CreateListFile_Click" />
            </StackPanel>
          </Grid>

          <ui:InfoBar Grid.Row="1" x:Name="ListsInfoBar" IsOpen="False" IsClosable="True" Margin="0,0,0,12" />

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,18,0">
            <ItemsControl x:Name="ListsItems">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Top" Margin="0,10,10,0" />

                    <Expander Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Expanded="ListExpander_Expanded">
                      <Expander.Header>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BadBadge}" Foreground="#E8B13B" FontWeight="SemiBold"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding ProblemVisibility}" />
                          </StackPanel>
                          <ui:TextBox Grid.Column="1" Text="{Binding Note, Mode=TwoWay}" PlaceholderText="заметка"
                                      Margin="18,0,8,0" VerticalAlignment="Center"
                                      FontSize="12" BorderThickness="0" Background="Transparent"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      PreviewMouseDown="NoteBox_PreviewMouseDown" LostFocus="ListNote_Commit" />
                        </Grid>
                      </Expander.Header>
                      <StackPanel Margin="0,6,0,4">
                        <ui:TextBox Text="{Binding Content}" AcceptsReturn="True" Height="240"
                                    FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                                    VerticalScrollBarVisibility="Auto" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                          <ui:Button Content="Сохранить" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                                     Tag="{Binding}" Click="ListFileSave_Click" Margin="0,0,8,0" />
                          <ui:Button Content="Экспорт" Icon="{ui:SymbolIcon ArrowExport24}"
                                     Tag="{Binding}" Click="ListFileExport_Click" />
                        </StackPanel>
                      </StackPanel>
                    </Expander>

                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                               Padding="6" VerticalAlignment="Top" Margin="4,6,0,0"
                               ToolTip="Удалить список" Tag="{Binding}" Click="ListFileDelete_Click" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <Grid x:Name="EditorPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="Стратегии" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,12"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="240" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" CornerRadius="8" BorderThickness="1" Padding="4"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                      Background="{DynamicResource ControlFillColorDefaultBrush}">
                <ListBox x:Name="EditorList" DisplayMemberPath="Label" BorderThickness="0"
                         Background="Transparent" SelectionChanged="EditorList_SelectionChanged" />
              </Border>
              <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                           Content="Добавить" Icon="{ui:SymbolIcon Add24}" Click="EditorAdd_Click" />
                <ui:Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                           Content="Удалить" Icon="{ui:SymbolIcon Delete24}" Click="EditorDelete_Click" />
              </Grid>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="16,0,0,0" Padding="0,0,16,0">
              <StackPanel x:Name="EditorForm" IsEnabled="False">
                <TextBlock Text="Название" FontWeight="SemiBold" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:TextBox x:Name="EditLabel" />

                <TextBlock Text="Команда winws2 (полная, как .bat; %~dp0 = корень приложения)" FontWeight="SemiBold"
                           Margin="0,14,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:TextBox x:Name="EditArgs" AcceptsReturn="True" Height="280" FontFamily="Consolas"
                            TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                            PlaceholderText="Полная команда winws2. Можно вставить строку из .bat (start &quot;…&quot; /min &quot;%~dp0winws2.exe&quot; …) — префикс и переносы ^ распознаются." />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                  <ui:Button Content="Сохранить" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                             Click="EditorSave_Click" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>

        <Grid x:Name="JournalPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,4,0,12">
            <TextBlock Text="Журнал" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:Button HorizontalAlignment="Right" Content="Очистить"
                       Icon="{ui:SymbolIcon Eraser24}" Click="ClearLog_Click" />
          </Grid>
          <Border Grid.Row="1" CornerRadius="8" Padding="12"
                  Background="{DynamicResource ControlFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <TextBox x:Name="LogBox" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     Background="Transparent" BorderThickness="0" />
          </Border>
        </Grid>

        <Grid x:Name="DiagnosticsPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="Диагностика" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,12"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,18,0">
            <StackPanel>
              <Grid Margin="0,0,0,4">
                <TextBlock Text="Проверка системы" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:Button x:Name="RunDiagButton" HorizontalAlignment="Right" Content="Запустить"
                           Icon="{ui:SymbolIcon Play24}" Click="RunDiag_Click" />
              </Grid>
              <TextBlock Text="Ищет конфликты (другие обходы, VPN, прокси, службы) и проблемы окружения."
                         FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <ItemsControl x:Name="DiagResults">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,3" Padding="12,9" CornerRadius="6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding Brush}"
                                 VerticalAlignment="Center" Margin="0,1,14,0" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                          <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Margin="0,18,0,14" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

              <Grid Margin="0,0,0,4">
                <TextBlock Text="Тесты доступности" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:Button x:Name="RunTestButton" HorizontalAlignment="Right" Content="Проверить"
                           Icon="{ui:SymbolIcon Play24}" Click="RunTest_Click" />
              </Grid>
              <TextBlock Text="Прогоняет каждую стратегию по очереди и показывает, какие сервисы через неё открываются. Раскройте стратегию для деталей."
                         FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Тип проверки:" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="TestTypeCombo" SelectedIndex="0" Width="260">
                  <ComboBoxItem Content="Стандартная (HTTP + TLS)" />
                  <ComboBoxItem Content="DPI-checker (TCP 16-20)" />
                </ComboBox>
              </StackPanel>

              <StackPanel x:Name="TestProgressPanel" Visibility="Collapsed" Margin="0,2,0,12">
                <Grid Margin="0,0,0,6">
                  <TextBlock x:Name="TestStatus" FontSize="13" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <TextBlock x:Name="TestPercent" HorizontalAlignment="Right" FontSize="12" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ProgressBar x:Name="TestProgress" Height="6" Minimum="0" Maximum="100" Value="0" />
              </StackPanel>
              <ItemsControl x:Name="StrategyTests">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Expander Margin="0,3">
                      <Expander.Header>
                        <Grid HorizontalAlignment="Stretch" Margin="0,0,14,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding Brush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                          <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="2" Text="{Binding Summary}" VerticalAlignment="Center" Margin="10,0,0,0"
                                     FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                      </Expander.Header>
                      <StackPanel Margin="4,4,0,6">
                        <Border CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                          <StackPanel>
                            <Grid Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="86" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0" Text="Сайт" Margin="14,8" FontSize="12" FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                              <TextBlock Grid.Column="1" Text="HTTP" Margin="0,8" HorizontalAlignment="Center" FontSize="12"
                                         FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                              <TextBlock Grid.Column="2" Text="TLS 1.2" Margin="0,8" HorizontalAlignment="Center" FontSize="12"
                                         FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                              <TextBlock Grid.Column="3" Text="TLS 1.3" Margin="0,8" HorizontalAlignment="Center" FontSize="12"
                                         FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                              <TextBlock Grid.Column="4" Text="Пинг" Margin="0,8" HorizontalAlignment="Center" FontSize="12"
                                         FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <ItemsControl ItemsSource="{Binding Rows}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border BorderThickness="0,0,0,1"
                                          BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <Grid>
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="86" />
                                      </Grid.ColumnDefinitions>
                                      <TextBlock Grid.Column="0" Text="{Binding Name}" Margin="14,9" VerticalAlignment="Center"
                                                 TextTrimming="CharacterEllipsis"
                                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                      <Border Grid.Column="1" BorderThickness="1,0,0,0" Padding="0,7"
                                              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <Border CornerRadius="4" Padding="9,2" HorizontalAlignment="Center"
                                                Background="{Binding Http.Bg}" ToolTip="{Binding Http.Tip}">
                                          <TextBlock Text="{Binding Http.Text}" FontSize="12" FontWeight="SemiBold"
                                                     Foreground="{Binding Http.Fg}" />
                                        </Border>
                                      </Border>
                                      <Border Grid.Column="2" BorderThickness="1,0,0,0" Padding="0,7"
                                              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <Border CornerRadius="4" Padding="9,2" HorizontalAlignment="Center"
                                                Background="{Binding Tls12.Bg}" ToolTip="{Binding Tls12.Tip}">
                                          <TextBlock Text="{Binding Tls12.Text}" FontSize="12" FontWeight="SemiBold"
                                                     Foreground="{Binding Tls12.Fg}" />
                                        </Border>
                                      </Border>
                                      <Border Grid.Column="3" BorderThickness="1,0,0,0" Padding="0,7"
                                              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <Border CornerRadius="4" Padding="9,2" HorizontalAlignment="Center"
                                                Background="{Binding Tls13.Bg}" ToolTip="{Binding Tls13.Tip}">
                                          <TextBlock Text="{Binding Tls13.Text}" FontSize="12" FontWeight="SemiBold"
                                                     Foreground="{Binding Tls13.Fg}" />
                                        </Border>
                                      </Border>
                                      <Border Grid.Column="4" BorderThickness="1,0,0,0" Padding="0,7"
                                              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <TextBlock Text="{Binding Ping.Text}" FontSize="12" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Foreground="{Binding Ping.Fg}" />
                                      </Border>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Analytics}" Margin="2,8,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      </StackPanel>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
          <TextBlock Text="Настройки" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,16"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <ui:ToggleSwitch x:Name="ThemeToggle" Content="Светлая тема" Margin="0,6"
                           Checked="Theme_Toggle" Unchecked="Theme_Toggle" />
          <ui:ToggleSwitch x:Name="AutostartToggle" Content="Автозапуск с Windows" Margin="0,6"
                           Checked="Autostart_Toggle" Unchecked="Autostart_Toggle" />
          <ui:ToggleSwitch x:Name="StartMinToggle" Content="Запускать свёрнутым в трей" Margin="0,6"
                           Checked="StartMin_Toggle" Unchecked="StartMin_Toggle" />

          <Border Margin="0,20,0,0" Padding="16,14" CornerRadius="8"
                  Background="{DynamicResource ControlFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
              <StackPanel.Resources>
                <Style x:Key="Swatch" TargetType="Button">
                  <Setter Property="Width" Value="30" />
                  <Setter Property="Height" Value="30" />
                  <Setter Property="Margin" Value="0,0,8,0" />
                  <Setter Property="Cursor" Value="Hand" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </StackPanel.Resources>

              <TextBlock Text="Внешний вид" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

              <TextBlock Text="Акцентный цвет" Margin="0,0,0,6"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <WrapPanel Margin="0,0,0,8">
                <Button Style="{StaticResource Swatch}" Background="#2E8BFF" Tag="#2E8BFF" Click="AccentSwatch_Click" />
                <Button Style="{StaticResource Swatch}" Background="#00B7C3" Tag="#00B7C3" Click="AccentSwatch_Click" />
                <Button Style="{StaticResource Swatch}" Background="#3FB950" Tag="#3FB950" Click="AccentSwatch_Click" />
                <Button Style="{StaticResource Swatch}" Background="#8E5CD9" Tag="#8E5CD9" Click="AccentSwatch_Click" />
                <Button Style="{StaticResource Swatch}" Background="#E85AAD" Tag="#E85AAD" Click="AccentSwatch_Click" />
                <Button Style="{StaticResource Swatch}" Background="#E85C5C" Tag="#E85C5C" Click="AccentSwatch_Click" />
                <Button Style="{StaticResource Swatch}" Background="#F7834B" Tag="#F7834B" Click="AccentSwatch_Click" />
                <Button Style="{StaticResource Swatch}" Background="#E8B13B" Tag="#E8B13B" Click="AccentSwatch_Click" />
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ui:Button Content="Системный" Tag="system" Click="AccentSwatch_Click" Margin="0,0,8,0" />
                <ui:TextBox x:Name="AccentHexBox" PlaceholderText="#RRGGBB" Width="110" Margin="0,0,8,0" />
                <ui:Button Content="Применить" Click="AccentHexApply_Click" />
              </StackPanel>

              <TextBlock Text="Шрифт" Margin="0,16,0,6"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <ComboBox x:Name="FontCombo" Width="260" HorizontalAlignment="Left"
                        SelectionChanged="FontCombo_SelectionChanged" />

              <TextBlock Text="Размер шрифта" Margin="0,16,0,6"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <ComboBox x:Name="FontSizeCombo" Width="90" HorizontalAlignment="Left"
                        SelectionChanged="FontSize_SelectionChanged" />
            </StackPanel>
          </Border>

          <Border Margin="0,20,0,0" Padding="16,14" CornerRadius="8"
                  Background="{DynamicResource ControlFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ShieldTask24" FontSize="22" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Zapret2" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              </StackPanel>
              <TextBlock x:Name="AboutVersion" Text="версия…" Margin="0,8,0,0" FontSize="13"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <TextBlock Margin="0,6,0,0" FontSize="13"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="Разработка:" />
                <Run Text="Egzyss + LoST" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              </TextBlock>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>

    <Grid x:Name="Scrim" Grid.Row="0" Grid.RowSpan="2" Background="#B0000000"
          Visibility="Collapsed" Panel.ZIndex="20" MouseDown="Scrim_MouseDown">
      <Border x:Name="AutoPickPanel" Visibility="Collapsed"
              Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
              Padding="18" CornerRadius="12"
              Background="{DynamicResource ApplicationBackgroundBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Авто-подбор" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock x:Name="AutoPickCurrent" Text="Подготовка…" Margin="0,0,0,8"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <ProgressBar x:Name="AutoPickBar" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,12" />
          <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AutoPickResults">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="13" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <ui:Button x:Name="AutoPickCloseBtn" Content="Отмена" HorizontalAlignment="Right"
                     Margin="0,14,0,0" Click="AutoPickClose_Click" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</ui:FluentWindow>
