<ui:FluentWindow x:Class="Zapret.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tb="http://www.hardcodet.net/taskbar"
                 xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
                 xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                 Title="Zapret2"
                 Width="820" Height="720"
                 MinWidth="700" MinHeight="560"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen">

  <ui:FluentWindow.Resources>
    <SolidColorBrush x:Key="RingOff" Color="#3B424B" po:Freeze="True" />

    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Nav" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Margin" Value="6,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
              <Grid>
                <Border x:Name="Pill" Width="3" Height="18" CornerRadius="1.5"
                        HorizontalAlignment="Left" Margin="2,0,0,0"
                        Background="{DynamicResource AccentTextFillColorPrimaryBrush}" Opacity="0" />
                <ContentPresenter VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter TargetName="Pill" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavIcon" TargetType="ui:SymbolIcon">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Dashboard card: subtle hover lift + accent border (Fluent micro-interaction). -->
    <Style x:Key="DashCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value>
          <TransformGroup>
            <ScaleTransform ScaleX="1" ScaleY="1" />
            <TranslateTransform />
          </TransformGroup>
        </Setter.Value>
      </Setter>
      <!-- Own brush so the border colour can animate per-card on hover. -->
      <Setter Property="BorderBrush">
        <Setter.Value>
          <SolidColorBrush Color="{DynamicResource CardStrokeColorDefault}" />
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" To="#802E8BFF" Duration="0:0:0.18">
                  <ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></ColorAnimation.EasingFunction>
                </ColorAnimation>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" Duration="0:0:0.28" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
      </Style.Triggers>
    </Style>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Zapret2" ShowMaximize="True">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/icon.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <tb:TaskbarIcon x:Name="Tray"
                    Grid.Row="0"
                    ToolTipText="Zapret2"
                    IconSource="pack://application:,,,/Assets/icon.ico"
                    TrayMouseDoubleClick="TrayOpen_Click">
      <tb:TaskbarIcon.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Открыть" Click="TrayOpen_Click" />
          <MenuItem x:Name="TrayToggle" Header="Подключить" Click="Toggle_Click" />
          <Separator />
          <MenuItem Header="Выход" Click="Exit_Click" />
        </ContextMenu>
      </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavColumn" Width="220" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Margin="0,4,0,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:Button x:Name="NavToggle" Grid.Row="0" Appearance="Transparent" Width="36" Padding="0,8" Margin="6,4,0,8"
                   HorizontalAlignment="Left" HorizontalContentAlignment="Center" Icon="{ui:SymbolIcon Navigation24}"
                   Click="NavToggle_Click" ToolTip="Свернуть меню" />

        <StackPanel Grid.Row="1">
          <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="dashboard"
                       IsChecked="True" Checked="Nav_Checked" ToolTip="Главная">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="Home24" />
              <TextBlock Grid.Column="1" x:Name="NavHomeLabel" Text="Главная" VerticalAlignment="Center" />
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavLists" Style="{StaticResource NavItem}" Tag="lists" Checked="Nav_Checked" ToolTip="Списки">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="TextBulletListSquare24" />
              <TextBlock Grid.Column="1" x:Name="NavListsLabel" Text="Списки" VerticalAlignment="Center" />
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavEditor" Style="{StaticResource NavItem}" Tag="editor" Checked="Nav_Checked" ToolTip="Стратегии">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="Wrench24" />
              <TextBlock Grid.Column="1" x:Name="NavEditorLabel" Text="Стратегии" VerticalAlignment="Center" />
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavJournal" Style="{StaticResource NavItem}" Tag="journal" Checked="Nav_Checked" ToolTip="Журнал">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="DocumentBulletList24" />
              <TextBlock Grid.Column="1" x:Name="NavJournalLabel" Text="Журнал" VerticalAlignment="Center" />
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavDiag" Style="{StaticResource NavItem}" Tag="diagnostics" Checked="Nav_Checked" ToolTip="Диагностика">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="Stethoscope24" />
              <TextBlock Grid.Column="1" x:Name="NavDiagLabel" Text="Диагностика" VerticalAlignment="Center" />
            </Grid>
          </RadioButton>
        </StackPanel>

        <RadioButton x:Name="NavSettings" Grid.Row="2" Style="{StaticResource NavItem}" Tag="settings"
                     Checked="Nav_Checked" ToolTip="Настройки">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="Settings24" />
            <TextBlock Grid.Column="1" x:Name="NavSettingsLabel" Text="Настройки" VerticalAlignment="Center" />
          </Grid>
        </RadioButton>
      </Grid>

      <Border Grid.Column="1" Width="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

      <Grid Grid.Column="2" Margin="24,8,24,20">

        <Grid x:Name="DashboardPanel">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- ===== Hero card: connect + status + strategy ===== -->
          <Border x:Name="HeroCard" Grid.Column="0" Width="360" CornerRadius="12" Padding="24"
                  Background="{DynamicResource ControlFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
              <Border Width="200" Height="200" Background="Transparent" Cursor="Hand"
                      MouseLeftButtonUp="Connect_Click" HorizontalAlignment="Center">
                <Grid>
                  <Ellipse x:Name="ConnectPulse" Width="200" Height="200"
                           Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}" StrokeThickness="2" Opacity="0" />
                  <Ellipse Width="200" Height="200" Stroke="#1AFFFFFF" StrokeThickness="1" />
                  <Ellipse x:Name="ConnectRing" Width="168" Height="168"
                           Stroke="{StaticResource RingOff}" StrokeThickness="6" Fill="#14000000" />
                  <Ellipse x:Name="Spinner" Width="168" Height="168" Visibility="Collapsed"
                           Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}" StrokeThickness="4"
                           StrokeDashArray="16 90" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                      <RotateTransform x:Name="SpinnerRotate" />
                    </Ellipse.RenderTransform>
                  </Ellipse>
                  <ui:SymbolIcon x:Name="ConnectIcon" Symbol="Power24" FontSize="58"
                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                 Foreground="{StaticResource RingOff}" />
                </Grid>
              </Border>

              <TextBlock x:Name="StatusTitle" Text="Не защищено" Margin="0,22,0,0"
                         FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              <TextBlock x:Name="StatusSub" Text="Нажмите кнопку, чтобы включить обход"
                         Margin="0,4,0,0" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"
                         TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

              <StackPanel x:Name="UptimePanel" Orientation="Horizontal" HorizontalAlignment="Center"
                          Margin="0,10,0,0" Visibility="Collapsed">
                <ui:SymbolIcon Symbol="Timer24" FontSize="15" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="UptimeText" Margin="7,0,0,0" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" FontFamily="Consolas"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              </StackPanel>

              <StackPanel x:Name="EngineStatsPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                          Margin="0,6,0,0" Visibility="Collapsed">
                <ui:SymbolIcon Symbol="Pulse24" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="EngineStatsText" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <TextBlock Text="СТРАТЕГИЯ" FontSize="11" FontWeight="SemiBold"
                         Margin="2,22,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <ComboBox x:Name="StrategyCombo" DisplayMemberPath="Label"
                        SelectionChanged="StrategyCombo_SelectionChanged"
                        HorizontalAlignment="Stretch" FontSize="14" Padding="12,8" />

              <ui:Button x:Name="AutoPickButton" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Center" Content="Авто-подбор"
                         Icon="{ui:SymbolIcon Sparkle24}" Click="AutoPick_Click" />
            </StackPanel>
          </Border>

          <!-- ===== Feature cards (composable) ===== -->
          <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:Button Grid.Row="0" HorizontalAlignment="Right" Appearance="Transparent" Content="Настроить"
                       Icon="{ui:SymbolIcon Options24}" FontSize="12" Margin="0,0,0,6"
                       Click="DashCustomize_Click" ToolTip="Выбрать карточки и их порядок" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="DashCards">

                <Border x:Name="CardLists" Style="{StaticResource DashCard}" Margin="0,0,0,12">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="TextBulletListSquare24" FontSize="18" VerticalAlignment="Center"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                      <TextBlock Text="Списки" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16"
                                 FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="ListCountsText" Margin="0,8,0,0" FontSize="14" Text="списки…"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                      <ui:Button Content="Открыть" Margin="0,0,8,0" Click="NavToLists_Click" />
                      <ui:Button Content="Обновить IP" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="Update_Click" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border x:Name="CardActions" Style="{StaticResource DashCard}" Margin="0,0,0,12">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="AppsList24" FontSize="18" VerticalAlignment="Center"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                      <TextBlock Text="Быстрые действия" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16"
                                 FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <WrapPanel Margin="0,12,0,0">
                      <ui:Button Content="Диагностика" Icon="{ui:SymbolIcon Stethoscope24}" Margin="0,4,8,4" Click="NavToDiag_Click" />
                      <ui:Button Content="Стратегии" Icon="{ui:SymbolIcon Wrench24}" Margin="0,4,8,4" Click="NavToEditor_Click" />
                      <ui:Button Content="Журнал" Icon="{ui:SymbolIcon DocumentBulletList24}" Margin="0,4,0,4" Click="NavToJournal_Click" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <Border x:Name="CardNet" Style="{StaticResource DashCard}" Margin="0,0,0,12">
                  <StackPanel>
                    <Grid>
                      <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Globe24" FontSize="18" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Сеть" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                      </StackPanel>
                      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button x:Name="NetMaskButton" Appearance="Transparent" Icon="{ui:SymbolIcon EyeOff24}"
                                   FontSize="12" Click="MaskInfo_Click" ToolTip="Скрыть / показать данные" />
                        <ui:Button x:Name="NetRefreshButton" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   FontSize="12" Click="NetRefresh_Click" ToolTip="Обновить" />
                      </StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="IP" FontSize="12" Margin="0,0,12,4"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock x:Name="InfoNetIp" Grid.Row="0" Grid.Column="1" Text="—" FontSize="13" FontWeight="SemiBold"
                                 Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Провайдер" FontSize="12" Margin="0,0,12,0"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock x:Name="InfoNetIsp" Grid.Row="1" Grid.Column="1" Text="—" FontSize="13" FontWeight="SemiBold"
                                 TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                  </StackPanel>
                </Border>

                <Border x:Name="CardProfiles" Style="{StaticResource DashCard}" Margin="0,0,0,12">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                      <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Bookmark24" FontSize="18" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Профили" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                      </StackPanel>
                      <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Content="Сохранить текущий"
                                 Icon="{ui:SymbolIcon Add24}" FontSize="12" Click="ProfileAdd_Click"
                                 ToolTip="Сохранить текущую стратегию как профиль" />
                    </Grid>

                    <TextBlock x:Name="ProfilesEmpty" Grid.Row="1" TextWrapping="Wrap" Margin="0,8,0,0"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Профилей пока нет. Выберите стратегию и нажмите «Сохранить текущий» — потом переключайтесь в один клик." />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="240" Margin="0,8,0,0">
                      <ItemsControl x:Name="ProfilesList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,3" Padding="4" CornerRadius="8"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderThickness="1" BorderBrush="{Binding Border}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalContentAlignment="Left" Padding="8,4" Tag="{Binding Id}"
                                    Click="ProfileApply_Click" ToolTip="Переключиться на этот профиль">
                              <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding StrategyLabel}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                              </StackPanel>
                            </Button>
                            <ui:Button Grid.Column="1" Appearance="Transparent" VerticalAlignment="Center"
                                       Icon="{ui:SymbolIcon Delete24}" Tag="{Binding Id}"
                                       Click="ProfileDelete_Click" ToolTip="Удалить профиль" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>

              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>

        <Grid x:Name="ListsPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,4,0,12">
            <TextBlock Text="Списки" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <WrapPanel Margin="0,10,0,0">
              <CheckBox x:Name="SelectAllCheck" Content="Все" VerticalAlignment="Center" Margin="0,4,16,4"
                        Checked="SelectAll_Changed" Unchecked="SelectAll_Changed" />
              <ui:Button Content="Добавить файл" Icon="{ui:SymbolIcon ArrowImport24}" Margin="0,4,8,4"
                         Click="AddListFile_Click" />
              <ui:Button Content="Создать" Icon="{ui:SymbolIcon DocumentAdd24}" Margin="0,4,8,4"
                         Click="CreateListFile_Click" />
              <ui:Button Content="Обновить IP" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="0,4,8,4"
                         ToolTip="Скачать свежий ipset-all.txt" Click="Update_Click" />
              <ui:Button Content="Экспорт выбранных" Icon="{ui:SymbolIcon ArrowExport24}" Margin="0,4,8,4"
                         Click="ExportSelected_Click" />
              <ui:Button Content="Удалить выбранные" Icon="{ui:SymbolIcon Delete24}" Margin="0,4,0,4"
                         Click="DeleteSelected_Click" />
            </WrapPanel>
          </StackPanel>

          <ui:InfoBar Grid.Row="1" x:Name="ListsInfoBar" IsOpen="False" IsClosable="True" Margin="0,0,0,12" />

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,18,0">
            <ItemsControl x:Name="ListsItems">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Top" Margin="0,10,10,0" />

                    <Expander Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Expanded="ListExpander_Expanded">
                      <Expander.Header>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BadBadge}" Foreground="#E8B13B" FontWeight="SemiBold"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding ProblemVisibility}" />
                          </StackPanel>
                          <ui:TextBox Grid.Column="1" Text="{Binding Note, Mode=TwoWay}" PlaceholderText="заметка"
                                      Margin="18,0,8,0" VerticalAlignment="Center"
                                      FontSize="12" BorderThickness="0" Background="Transparent"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      PreviewMouseDown="NoteBox_PreviewMouseDown" LostFocus="ListNote_Commit" />
                        </Grid>
                      </Expander.Header>
                      <StackPanel Margin="0,6,0,4">
                        <ui:TextBox Text="{Binding Content}" AcceptsReturn="True" Height="240"
                                    FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                                    VerticalScrollBarVisibility="Auto" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                          <ui:Button Content="Сохранить" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                                     Tag="{Binding}" Click="ListFileSave_Click" Margin="0,0,8,0" />
                          <ui:Button Content="Экспорт" Icon="{ui:SymbolIcon ArrowExport24}"
                                     Tag="{Binding}" Click="ListFileExport_Click" />
                        </StackPanel>
                      </StackPanel>
                    </Expander>

                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent"
                               Padding="6" VerticalAlignment="Top" Margin="4,6,0,0"
                               ToolTip="Удалить список" Tag="{Binding}" Click="ListFileDelete_Click" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <Grid x:Name="EditorPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="Стратегии" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,12"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="240" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" CornerRadius="8" BorderThickness="1" Padding="4"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                      Background="{DynamicResource ControlFillColorDefaultBrush}">
                <ListBox x:Name="EditorList" DisplayMemberPath="Label" BorderThickness="0"
                         Background="Transparent" SelectionChanged="EditorList_SelectionChanged" />
              </Border>
              <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ui:Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                             Content="Добавить" Icon="{ui:SymbolIcon Add24}" Click="EditorAdd_Click" />
                  <ui:Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                             Content="Удалить" Icon="{ui:SymbolIcon Delete24}" Click="EditorDelete_Click" />
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ui:Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                             Content="Импорт" Icon="{ui:SymbolIcon ArrowImport24}" Click="EditorImport_Click" />
                  <ui:Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                             Content="Экспорт" Icon="{ui:SymbolIcon ArrowExport24}" Click="EditorExport_Click" />
                </Grid>
              </StackPanel>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="16,0,0,0" Padding="0,0,16,0">
              <StackPanel x:Name="EditorForm" IsEnabled="False">
                <TextBlock Text="Название" FontWeight="SemiBold" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:TextBox x:Name="EditLabel" />

                <TextBlock Text="Команда winws2 (полная, как .bat; %~dp0 = корень приложения)" FontWeight="SemiBold"
                           Margin="0,14,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Подсветка синтаксиса. Начните вводить -- для автодополнения (или Ctrl+Space). Подсказка параметра всплывает над курсором."
                           FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Border CornerRadius="6" BorderThickness="1" Padding="2"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                  <avalonedit:TextEditor x:Name="EditArgs" Height="280" FontFamily="Consolas" FontSize="13"
                                         ShowLineNumbers="True" WordWrap="False"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>

                <Expander x:Name="RefExpander" Margin="0,10,0,0" IsExpanded="False"
                          Header="Справочник аргументов — поиск и клик для вставки">
                  <StackPanel Margin="0,8,0,0">
                    <ui:TextBox x:Name="RefSearch" Icon="{ui:SymbolIcon Search24}" Margin="0,0,0,8"
                                PlaceholderText="Поиск: флаг, метод, параметр, значение…"
                                TextChanged="RefSearch_TextChanged" />
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                      <ItemsControl x:Name="RefList">
                        <ItemsControl.GroupStyle>
                          <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,3"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                              </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                          </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,5" Margin="0,1"
                                    HorizontalContentAlignment="Stretch" Tag="{Binding Insert}"
                                    Click="RefChip_Click" ToolTip="Вставить в позицию курсора">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" MinWidth="190" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="Consolas" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Hint}" FontSize="12" TextWrapping="Wrap"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Expander>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                  <ui:Button Content="Сохранить" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                             Click="EditorSave_Click" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>

        <Grid x:Name="JournalPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,4,0,12">
            <TextBlock Text="Журнал" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:Button HorizontalAlignment="Right" Content="Очистить"
                       Icon="{ui:SymbolIcon Eraser24}" Click="ClearLog_Click" />
          </Grid>
          <Border Grid.Row="1" CornerRadius="8" Padding="12"
                  Background="{DynamicResource ControlFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <TextBox x:Name="LogBox" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     Background="Transparent" BorderThickness="0" />
          </Border>
        </Grid>

        <Grid x:Name="DiagnosticsPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="Диагностика" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,12"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,18,0">
            <StackPanel>
              <Grid Margin="0,0,0,4">
                <TextBlock Text="Система и сеть" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <ui:Button x:Name="MaskInfoButton" Content="Скрыть" Icon="{ui:SymbolIcon EyeOff24}"
                             Margin="0,0,8,0" Click="MaskInfo_Click"
                             ToolTip="Замазать личные данные для скриншота" />
                  <ui:Button x:Name="RefreshInfoButton" Content="Обновить" Icon="{ui:SymbolIcon ArrowClockwise24}"
                             Click="RefreshInfo_Click" />
                </StackPanel>
              </Grid>
              <TextBlock Text="Публичный IP, провайдер и параметры системы. Кнопкой «Скрыть» можно замазать личные данные перед отправкой скриншота."
                         FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

              <Border Padding="16" CornerRadius="8"
                      Background="{DynamicResource ControlFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Публичный IP" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="InfoPublicIp" Text="—" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,10"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="ASN" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="InfoAsn" Text="—" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,10"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Провайдер (ISP)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="InfoIsp" Text="—" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,10"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Расположение" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="InfoLocation" Text="—" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Система" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="InfoOs" Text="—" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,10"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Процессор" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="InfoCpu" Text="—" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,10"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Память" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="InfoRam" Text="—" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,10"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Имя ПК" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="InfoMachine" Text="—" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,10"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Аптайм" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="InfoUptime" Text="—" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border Margin="0,18,0,14" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

              <Grid Margin="0,0,0,4">
                <TextBlock Text="Проверка системы" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:Button x:Name="RunDiagButton" HorizontalAlignment="Right" Content="Запустить"
                           Icon="{ui:SymbolIcon Play24}" Click="RunDiag_Click" />
              </Grid>
              <TextBlock Text="Ищет конфликты (другие обходы, VPN, прокси, службы) и проблемы окружения."
                         FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <ItemsControl x:Name="DiagResults">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,3" Padding="12,9" CornerRadius="6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding Brush}"
                                 VerticalAlignment="Center" Margin="0,1,14,0" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                          <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Margin="0,18,0,14" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

              <Grid Margin="0,0,0,4">
                <TextBlock Text="Тесты доступности" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:Button x:Name="RunTestButton" HorizontalAlignment="Right" Content="Проверить"
                           Icon="{ui:SymbolIcon Play24}" Click="RunTest_Click" />
              </Grid>
              <TextBlock Text="Прогоняет каждую стратегию по очереди и показывает, какие сервисы через неё открываются. Раскройте стратегию для деталей."
                         FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Тип проверки:" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="TestTypeCombo" SelectedIndex="0" Width="260">
                  <ComboBoxItem Content="Стандартная (HTTP + ping)" />
                  <ComboBoxItem Content="DPI-checker (TCP 16-20)" />
                </ComboBox>
              </StackPanel>

              <TextBlock x:Name="TestStatus" Visibility="Collapsed" Margin="0,0,0,8" FontSize="13"
                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
              <ItemsControl x:Name="StrategyTests">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Expander Margin="0,3">
                      <Expander.Header>
                        <Grid HorizontalAlignment="Stretch" Margin="0,0,14,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding Brush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                          <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="2" Text="{Binding Summary}" VerticalAlignment="Center" Margin="10,0,0,0"
                                     FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                      </Expander.Header>
                      <ItemsControl ItemsSource="{Binding Rows}" Margin="8,4,0,6">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,3">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding Brush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                              <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                              <TextBlock Grid.Column="2" Text="{Binding Detail}" VerticalAlignment="Center" FontSize="12"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
          <TextBlock Text="Настройки" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,16"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <ui:ToggleSwitch x:Name="ThemeToggle" Content="Светлая тема" Margin="0,6"
                           Checked="Theme_Toggle" Unchecked="Theme_Toggle" />
          <ui:ToggleSwitch x:Name="AutostartToggle" Content="Автозапуск с Windows" Margin="0,6"
                           Checked="Autostart_Toggle" Unchecked="Autostart_Toggle" />
          <ui:ToggleSwitch x:Name="StartMinToggle" Content="Запускать свёрнутым в трей" Margin="0,6"
                           Checked="StartMin_Toggle" Unchecked="StartMin_Toggle" />
          <ui:ToggleSwitch x:Name="AutoConnectToggle" Content="Подключать обход при запуске" Margin="0,6"
                           Checked="AutoConnect_Toggle" Unchecked="AutoConnect_Toggle" />

          <Border Margin="0,20,0,0" Padding="16,14" CornerRadius="8"
                  Background="{DynamicResource ControlFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
              <StackPanel.Resources>
                <Style x:Key="Swatch" TargetType="Button">
                  <Setter Property="Width" Value="30" />
                  <Setter Property="Height" Value="30" />
                  <Setter Property="Margin" Value="0,0,8,0" />
                  <Setter Property="Cursor" Value="Hand" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </StackPanel.Resources>

              <TextBlock Text="Внешний вид" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

              <TextBlock Text="Акцентный цвет" Margin="0,0,0,6"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <WrapPanel Margin="0,0,0,8">
                <Button Style="{StaticResource Swatch}" Background="#2E8BFF" Tag="#2E8BFF" Click="AccentSwatch_Click" />
                <Button Style="{StaticResource Swatch}" Background="#00B7C3" Tag="#00B7C3" Click="AccentSwatch_Click" />
                <Button Style="{StaticResource Swatch}" Background="#3FB950" Tag="#3FB950" Click="AccentSwatch_Click" />
                <Button Style="{StaticResource Swatch}" Background="#8E5CD9" Tag="#8E5CD9" Click="AccentSwatch_Click" />
                <Button Style="{StaticResource Swatch}" Background="#E85AAD" Tag="#E85AAD" Click="AccentSwatch_Click" />
                <Button Style="{StaticResource Swatch}" Background="#E85C5C" Tag="#E85C5C" Click="AccentSwatch_Click" />
                <Button Style="{StaticResource Swatch}" Background="#F7834B" Tag="#F7834B" Click="AccentSwatch_Click" />
                <Button Style="{StaticResource Swatch}" Background="#E8B13B" Tag="#E8B13B" Click="AccentSwatch_Click" />
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ui:Button Content="Системный" Tag="system" Click="AccentSwatch_Click" Margin="0,0,8,0" />
                <ui:TextBox x:Name="AccentHexBox" PlaceholderText="#RRGGBB" Width="110" Margin="0,0,8,0" />
                <ui:Button Content="Применить" Click="AccentHexApply_Click" />
              </StackPanel>

              <TextBlock Text="Шрифт" Margin="0,16,0,6"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <ComboBox x:Name="FontCombo" Width="260" HorizontalAlignment="Left"
                        SelectionChanged="FontCombo_SelectionChanged" />

              <TextBlock Text="Размер шрифта" Margin="0,16,0,6"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <ComboBox x:Name="FontSizeCombo" Width="90" HorizontalAlignment="Left"
                        SelectionChanged="FontSize_SelectionChanged" />
            </StackPanel>
          </Border>

          <Border Margin="0,20,0,0" Padding="16,14" CornerRadius="8"
                  Background="{DynamicResource ControlFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ShieldTask24" FontSize="22" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Zapret2" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              </StackPanel>
              <TextBlock x:Name="AboutVersion" Text="версия…" Margin="0,8,0,0" FontSize="13"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <TextBlock Margin="0,6,0,0" FontSize="13"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="Разработка:" />
                <Run Text="Egzyss + LoST" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              </TextBlock>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Grid>

    <Grid x:Name="Scrim" Grid.Row="0" Grid.RowSpan="2" Background="#B0000000"
          Visibility="Collapsed" Panel.ZIndex="20" MouseDown="Scrim_MouseDown">
      <Border x:Name="AutoPickPanel" Visibility="Collapsed"
              Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
              Padding="18" CornerRadius="12"
              Background="{DynamicResource ApplicationBackgroundBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Авто-подбор" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock x:Name="AutoPickCurrent" Text="Подготовка…" Margin="0,0,0,8"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <ProgressBar x:Name="AutoPickBar" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,12" />
          <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AutoPickResults">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="13" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <ui:Button x:Name="AutoPickCloseBtn" Content="Отмена" HorizontalAlignment="Right"
                     Margin="0,14,0,0" Click="AutoPickClose_Click" />
        </StackPanel>
      </Border>

      <Border x:Name="ProfileNamePanel" Visibility="Collapsed"
              Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
              Padding="18" CornerRadius="12"
              Background="{DynamicResource ApplicationBackgroundBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Новый профиль" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock x:Name="ProfileNameHint" Text="Сохранит текущую стратегию под этим именем." Margin="0,0,0,12"
                     FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <ui:TextBox x:Name="ProfileNameBox" PlaceholderText="напр. Дом, Работа, Провайдер X"
                      KeyDown="ProfileNameBox_KeyDown" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <ui:Button Content="Отмена" Margin="0,0,8,0" Click="ProfileNameCancel_Click" />
            <ui:Button x:Name="ProfileNameSaveBtn" Content="Сохранить" Appearance="Primary"
                       Click="ProfileNameSave_Click" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="DashCustomizePanel" Visibility="Collapsed"
              Width="420" MaxHeight="540" VerticalAlignment="Center" HorizontalAlignment="Center"
              Padding="18" CornerRadius="12"
              Background="{DynamicResource ApplicationBackgroundBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Главный экран" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock Text="Отметьте карточки, которые закрепить, и задайте порядок стрелками." Margin="0,0,0,12"
                     FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <ItemsControl x:Name="DashOptionsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,3" Padding="8,4" CornerRadius="8"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="14"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:Button Grid.Column="2" Appearance="Transparent" Icon="{ui:SymbolIcon ChevronUp24}"
                               Tag="{Binding Key}" Click="DashOptUp_Click" ToolTip="Выше" />
                    <ui:Button Grid.Column="3" Appearance="Transparent" Icon="{ui:SymbolIcon ChevronDown24}"
                               Tag="{Binding Key}" Click="DashOptDown_Click" ToolTip="Ниже" />
                  </Grid>
                </Border>
